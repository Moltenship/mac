// Place your key bindings in this file to override the defaults
[
  {
    "key": "shift+cmd+i",
    "command": "inlineChat.start",
    "when": "inlineChatHasProvider && !editorReadonly"
  },
  {
    "key": "cmd+i",
    "command": "-inlineChat.start",
    "when": "inlineChatHasProvider && !editorReadonly"
  },
  {
    "key": "shift+cmd+i",
    "command": "github.copilot.terminal.suggestCommand",
    "when": "terminalFocus"
  },
  {
    "key": "cmd+i",
    "command": "-github.copilot.terminal.suggestCommand",
    "when": "terminalFocus"
  },
  {
    "key": "shift+cmd+i",
    "command": "inlineChat.start",
    "when": "editorFocus && inlineChatHasProvider && !editorReadonly"
  },
  {
    "key": "cmd+i",
    "command": "-inlineChat.start",
    "when": "editorFocus && inlineChatHasProvider && !editorReadonly"
  },
  {
    "key": "shift+cmd+i",
    "command": "-supermaven.addToChat"
  },
  {
    "key": "cmd+i",
    "command": "-workbench.action.terminal.chat.focusInput",
    "when": "terminalChatFocus && !inlineChatFocused"
  },
  {
    "key": "cmd+i",
    "command": "-supermaven.editWithSupermaven"
  }
]