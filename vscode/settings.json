{
  "editor.matchBrackets": false,
  "kite.showWelcomeNotificationOnStartup": false,
  "liveServer.settings.donotShowInfoMsg": true,
  "emmet.triggerExpansionOnTab": true,
  "emmet.showSuggestionsAsSnippets": true,
  "vsicons.dontShowNewVersionMessage": true,
  "liveServer.settings.donotVerifyTags": true,
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[css]": {
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.fontLigatures": false,
  "editor.mouseWheelZoom": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "quickfix.biome": "explicit",
    "source.fixAll.stylelint": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "files.eol": "\n",
  "C_Cpp.updateChannel": "Insiders",
  "discord.workspaceElapsedTime": true,
  "editor.linkedEditing": true,
  "terminal.integrated.fontFamily": "'IosevkaTerm Nerd Font', 'JetBrainsMono NFM', 'FiraCode Nerd Font', monospace",
  "tabnine.experimentalAutoImports": true,
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "explorer.confirmDelete": false,
  "python.languageServer": "Pylance",
  "jupyter.askForKernelRestart": false,
  "windicss.enableHoverPreview": true,
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter.notebook.ipynb",
    "git-rebase-todo": "default"
  },
  "jupyter.alwaysTrustNotebooks": true,
  "terminal.integrated.tabs.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "explorer.compactFolders": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "workbench.list.smoothScrolling": true,
  "gitlens.gitCommands.skipConfirmations": [
    "fetch:command",
    "stash-push:command",
    "switch:command",
    "branch-create:command"
  ],
  "[vue]": {
    "editor.defaultFormatter": "johnsoncodehk.volar"
  },
  "git.confirmSync": false,
  "explorer.confirmDragAndDrop": false,
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "apollographql.trace.server": "messages",
  "workbench.preferredDarkColorTheme": "Vesper",
  "workbench.preferredLightColorTheme": "Vesper",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "prettier.arrowParens": "avoid",
  "redhat.telemetry.enabled": true,
  "prettier.printWidth": 140,
  "editor.parameterHints.cycle": true,
  "editor.formatOnSave": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.suggest.preview": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "debug.javascript.autoAttachFilter": "disabled",
  "workbench.colorCustomizations": {},
  "editor.codeLensFontFamily": "'Iosevka Term', 'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
  "editor.inlineSuggest.enabled": true,
  "terminal.integrated.fontWeight": "normal",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "githubPullRequests.pullBranch": "never",
  "git.openRepositoryInParentFolders": "always",
  "editor.renderWhitespace": "all",
  "git.allowNoVerifyCommit": true,
  "git.confirmNoVerifyCommit": false,
  "editor.fontSize": 14,
  "editor.guides.bracketPairs": true,
  "workbench.sideBar.location": "right",
  "git.autofetch": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "yaml": true
  },
  "totalTypeScript.hideAllTips": false,
  "totalTypeScript.hideBasicTips": true,
  "terminal.integrated.automationProfile.osx": {},
  "editor.cursorBlinking": "expand",
  "color-highlight.matchWords": true,
  "editor.colorDecorators": false,
  "discord.removeRemoteRepository": true,
  "prettier.configPath": ".prettierrc.json",
  "javascript.suggest.jsdoc.generateReturns": false,
  "typescript.suggest.jsdoc.generateReturns": false,
  "reactSnippets.settings.importReactOnTop": false,
  "editor.codeActionWidget.includeNearbyQuickFixes": true,
  "git.mergeEditor": true,
  "terminal.integrated.fontSize": 13,
  "window.title": "${activeEditorMedium}",
  "apc.font.family": "Iosevka",
  "prettier.requireConfig": true,
  "discord.lowerDetailsEditing": "Directory: {dir_name}/{file_name}",
  "settingsSync.ignoredSettings": [
    "workbench.colorTheme",
    "js/ts.tsserver.node.path",
    "js/ts.suggest.autoImports",
    "js/ts.experimental.useTsgo"
  ],
  "github.copilot.editor.enableAutoCompletions": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "workbench.colorTheme": "Vesper",
  "supermaven.enable": {
    "*": true
  },
  "emmet.includeLanguages": {
    "postcss": "css"
  },
  "[postcss]": {
    "editor.defaultFormatter": "stylelint.vscode-stylelint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.fontFamily": "'Iosevka', 'Iosevka Term', 'JetBrains Mono', Menlo, Monaco,'JetBrains Mono', 'PragmataPro', 'Fira Code', Consolas, 'Courier New', monospace",
  "editor.tabSize": 2,
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.iconTheme": "moxer-icons-fork",
  "settingsSync.ignoredExtensions": [
    "eg2.tslint"
  ]
}
