# Login shells normally initialize Homebrew in .zprofile. Avoid doing it twice.
if [[ -z ${HOMEBREW_PREFIX:-} ]] || (( ! $+commands[brew] )); then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

# Support the existing standalone mise installation as well as Homebrew's mise.
typeset -U path fpath
path=("$HOME/.local/bin" $path)

# Keep native history for fast, in-memory autosuggestions and an Atuin fallback.
HISTFILE=${HISTFILE:-${ZDOTDIR:-$HOME}/.zsh_history}
HISTSIZE=20000
SAVEHIST=20000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST HIST_REDUCE_BLANKS

if [[ -n ${HOMEBREW_PREFIX:-} ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions"
         "$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
fi
# compinit maintains its own dump cache and still checks directory permissions.
autoload -Uz compinit
compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false

bindkey -e
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Load only fzf's keybindings. fzf-tab owns Tab, and Atuin owns Ctrl-R.
if [[ -r "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ]]; then
  if (( $+commands[atuin] )); then
    FZF_CTRL_R_COMMAND='' source "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
  else
    source "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
  fi
fi
if [[ -r "$HOMEBREW_PREFIX/share/fzf-tab/fzf-tab.zsh" ]]; then
  zstyle ':completion:*' menu no
  source "$HOMEBREW_PREFIX/share/fzf-tab/fzf-tab.zsh"
fi

command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow --disable-ai)"

# Set this AFTER Atuin init, which otherwise adds a database query per suggestion.
ZSH_AUTOSUGGEST_STRATEGY=(history)
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=200
# Bind widgets once at the first prompt instead of scanning them after each command.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_HIGHLIGHT_MAXLENGTH=1000

# Keep machine-specific additions outside this repository.
[[ ! -f "$HOME/.zshrc.local" ]] || source "$HOME/.zshrc.local"

if [[ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
# Syntax highlighting must follow the other widget definitions.
if [[ -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
